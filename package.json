{
  "name": "zugblick",
  "version": "1.0.15",
  "private": true,
  "description": "Stockfish in Echtzeit auf jeder Schachseite – Browser-Erweiterung für Chrome, Edge und Brave.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "userscript": "node scripts/build-userscript.mjs",
    "postinstall": "wxt prepare",
    "bench:collect": "node tools/bench/collect.mjs",
    "bench": "node tools/bundle-recognize.mjs && node tools/bench/run.mjs",
    "templates": "node tools/bundle-recognize.mjs && node tools/make-templates.mjs",
    "icons": "node tools/make-icons.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lichess-org/chessground": "10.5.0",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "27.2.9",
    "lucide-react": "1.78.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "tailwind-merge": "3.7.1",
    "worker-timers-broker": "8.0.18",
    "worker-timers-worker": "9.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "esbuild": "0.25.12",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
